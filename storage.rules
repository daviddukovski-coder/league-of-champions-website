rules_version = '2';

// League of Champions – Cloud Storage security rules.
// Paste into Firebase Console → Storage → Rules → Publish
// (or deploy with `firebase deploy --only storage`).
//
// Uploaded files are public to read (they are shown on the site), but only
// images/videos within a size limit may be uploaded: site images by the
// admin, profile photos/videos by the player themselves.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.uid in ['YZL9Fl2AF9WUKflyKpF8VhRCGW03']; }
    function isImage(maxMb) { return request.resource.contentType.matches('image/(png|jpeg|webp|gif|heic|heif|svg\\+xml)') && request.resource.size < maxMb * 1024 * 1024; }
    function isVideo(maxMb) { return request.resource.contentType.matches('video/(mp4|quicktime|webm)') && request.resource.size < maxMb * 1024 * 1024; }

    // site content: hero image/video, sponsor logos, tournament photos, team photo
    match /content/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || isImage(15) || isVideo(80));
    }

    // player profile photo / short video
    match /players/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin())
        && (request.resource == null || isImage(10) || isVideo(60));
    }

    // everything else: closed
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
