{
  "name": "untertitel",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion-Untertitel (1080x1920, 30 fps, transparenter Hintergrund)",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Untertitel out/untertitel.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png",
    "render:webm": "remotion render Untertitel out/untertitel.webm --codec=vp9 --pixel-format=yuva420p --image-format=png",
    "render:green": "remotion render Untertitel out/untertitel-greenscreen.mp4 --codec=h264 --props={\"greenScreen\":true}"
  },
  "dependencies": {
    "@fontsource/montserrat": "5.3.0",
    "@remotion/cli": "4.0.534",
    "@remotion/layout-utils": "4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
